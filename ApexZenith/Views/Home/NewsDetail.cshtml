@model ApexZenith.Models.NewsPageViewModel
@{
    var currentNews = Model.CurrentNews;
    var allNews = Model.AllNews;
}

<div class="container">
    <div class="row">
        <div class="col-lg-8">
            <section id="blog-details" class="blog-details section">
                <div class="container">
                    <article class="article">
                        <div class="post-img">
                            <img src="@(currentNews.PhotoUrl ?? string.Empty)" class="img-fluid" alt="">
                        </div>
                        <h2 class="title">@currentNews.Headline</h2>
                        <div class="meta-top">
                            <ul>
                                <li class="d-flex align-items-center">
                                    <i class="bi bi-person"></i>
                                    <span>@currentNews.Author</span>
                                </li>
                                <li class="d-flex align-items-center">
                                    <i class="bi bi-clock"></i>
                                    <time datetime="@currentNews.Date.ToString("yyyy-MM-dd")">@currentNews.Date.ToString("yyyy-MM-dd")</time>
                                </li>
                            </ul>
                        </div>
                        <div class="content">
                            @currentNews.Content
                        </div>
                        <div class="meta-bottom">
                            <i class="bi bi-folder"></i>
                            <ul class="cats">
                            <li><a href="#">@currentNews.PostedBy</a></li>
                            </ul>
                        </div>
                    </article>
                </div>
            </section>
        </div>
        <div class="col-lg-4 sidebar">
            <div class="widgets-container">
                <div class="recent-posts-widget widget-item">
                    <h3 class="widget-title">Recent Insights</h3>
                    @foreach (var item in allNews.Where(b => b.Id != currentNews.Id).Take(5))
                    {
                        <div class="post-item">
                            <h4><a asp-action="NewsDetail" asp-route-id="@item.Id">@item.Headline</a></h4>
                            <time datetime="@item.Date.ToString("yyyy-MM-dd")">@item.Date.ToString("yyyy-MM-dd")</time>
                        </div>
                    }
                </div>
                <div class="tags-widget widget-item">
                    <h3 class="widget-title">Topics</h3>
                    <ul>
                        @foreach (var tag in allNews.Select(n => n.PostedBy).Where(name => !string.IsNullOrWhiteSpace(name)).Distinct())
                        {
                            <li><a href="#">@tag</a></li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
