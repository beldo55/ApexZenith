<header id="header" class="header d-flex align-items-center sticky-top">
    <div class="container position-relative d-flex align-items-center">

        <a asp-controller="Home" asp-action="Index" class="logo site-brand d-flex align-items-center me-auto">
            <span class="site-brand-icon" aria-hidden="true">
                <i class="bi bi-lightning-charge-fill"></i>
            </span>
            <span class="site-brand-name">ApexZenith</span>
        </a>

        <nav id="navmenu" class="navmenu">
            <ul>
                <li><a asp-controller="Home" asp-action="Index" class="active">Home</a></li>
                <li class="dropdown">
                    <a asp-controller="Home" asp-action="About"><span>About</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Team">Team</a></li>
                        <li><a asp-controller="Home" asp-action="Testimonials">Testimonials</a></li>
                    </ul>
                </li>
                <li><a asp-controller="Home" asp-action="Services">Services</a></li>
                <li><a asp-controller="Home" asp-action="News">News</a></li>
                <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                <li class="auth-nav-item">
                    <div class="header-auth-actions d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                    {
                            <a asp-area="Admin" asp-controller="Admin" asp-action="Index"
                               class="btn btn-outline-primary btn-sm auth-button">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard</span>
                        </a>

                            <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="auth-form">
                                <button class="btn btn-primary btn-sm auth-button" type="submit">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Logout</span>
                                </button>
                        </form>
                    }
                    else if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post"
                              class="auth-form">
                                <button class="btn btn-success btn-sm auth-button" type="submit">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Logout</span>
                                </button>
                        </form>
                    }

                    else if (User.Identity?.IsAuthenticated == false)
                    {
                        <a asp-area="Admin" asp-controller="Account" asp-action="Login"
                               class="btn btn-outline-primary btn-sm auth-button">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Login</span>
                        </a>


                        <a asp-area="Admin" asp-controller="Account" asp-action="Register"
                           class="btn btn-success btn-sm auth-button">
                            <i class="bi bi-person-plus"></i>
                            <span>Register</span>
                        </a>
                    }
                    </div>

                </li>
            </ul>

           
            <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
        </nav>


        


       </div>
       

    
</header>

