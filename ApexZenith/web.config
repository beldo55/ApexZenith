<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        PRODUCTION SECRETS — edit the *published* copy of this file before uploading to site4now.
        Leave the values empty here; never commit real credentials.
        ASP.NET Core maps double-underscore (__) to colon (:), so
        ConnectionStrings__DefaultConnection → ConnectionStrings:DefaultConnection.
      -->
      <aspNetCore processPath="dotnet" arguments=".\ApexZenith.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ConnectionStrings__DefaultConnection" value="" />
          <!-- BootstrapAdmin: only needed for the very first deploy (seeds the Admin account).
               Set BootstrapAdmin__Force to true on first deploy, then remove all three after seeding. -->
          <environmentVariable name="BootstrapAdmin__Email" value="" />
          <environmentVariable name="BootstrapAdmin__Password" value="" />
          <environmentVariable name="BootstrapAdmin__Force" value="false" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <authentication>
          <!-- Disable IIS Windows Authentication — it populates HttpContext.User
               with the app-pool machine account on every request, making
               IsAuthenticated == true for all visitors before any cookie is set. -->
          <windowsAuthentication enabled="false" />
          <anonymousAuthentication enabled="true" />
        </authentication>
      </security>
    </system.webServer>
  </location>
</configuration>
