@model ApexZenith.Areas.Admin.Models.ResourceFormModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add menu item";
    var parents = (IEnumerable<ApexZenith.Areas.Admin.Models.MenuParentOption>)(ViewBag.ParentOptions ?? Array.Empty<ApexZenith.Areas.Admin.Models.MenuParentOption>());
    var roles = (IEnumerable<string>)(ViewBag.RoleOptions ?? Array.Empty<string>());
}
<div class="row justify-content-center">
    <div class="col-12 col-xl-8">
        <div class="border rounded-3 p-4 bg-body">
            <form asp-action="Create" method="post" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <div class="mb-3">
                    <label class="form-label" asp-for="ParentId"></label>
                    <select asp-for="ParentId" class="form-select">
                        <option value="">(top level)</option>
                        @foreach (var p in parents)
                        {
                            <option value="@p.Id">#@p.Id - @p.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Name"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="DeveloperNote"></label>
                    <textarea asp-for="DeveloperNote" class="form-control" rows="2"></textarea>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" asp-for="Area"></label>
                        <input asp-for="Area" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="Controller"></label>
                        <input asp-for="Controller" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="Action"></label>
                        <input asp-for="Action" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="SettingsTabId"></label>
                        <input asp-for="SettingsTabId" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="IconClass"></label>
                        <input asp-for="IconClass" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="Order"></label>
                        <input asp-for="Order" class="form-control" type="number" />
                    </div>
                </div>
                <div class="form-check form-switch mt-3">
                    <input asp-for="IsAction" class="form-check-input" role="switch" />
                    <label class="form-check-label" asp-for="IsAction"></label>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" role="switch" />
                    <label class="form-check-label" asp-for="IsActive"></label>
                </div>
                <div class="form-text">Turn off if this row is a section header or tab-only item.</div>
                <div class="mt-4">
                    <div class="form-label">Visible to roles</div>
                    <div class="form-text mb-2">Leave everything unchecked to allow any authenticated user.</div>
                    @if (roles.Any())
                    {
                        foreach (var role in roles)
                        {
                            var id = $"role_{role.Replace(" ", "_")}";
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role" id="@id" />
                                <label class="form-check-label" for="@id">@role</label>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-secondary small">No roles are available yet.</div>
                    }
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
