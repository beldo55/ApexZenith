@model ApexZenith.Areas.Admin.Models.ResourceFormModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Delete menu item";
}
<div class="row justify-content-center">
    <div class="col-12 col-xl-7">
        <div class="alert alert-warning border">
            <h5 class="alert-heading mb-2">Delete this menu item?</h5>
            <p class="mb-2">This removes the resource and its role links. Child items must be deleted first.</p>
            <dl class="row mb-0 small">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>
                <dt class="col-sm-3">Route</dt>
                <dd class="col-sm-9">@Model.Area / @Model.Controller / @Model.Action</dd>
                <dt class="col-sm-3">Order</dt>
                <dd class="col-sm-9">@Model.Order</dd>
            </dl>
        </div>
        <form asp-action="DeleteConfirmed" method="post" class="d-flex gap-2">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
