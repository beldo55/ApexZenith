@model ApexZenith.Models.Team
@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Delete Team Member"; }
<form asp-action="DeleteTeam" method="post" class="container">
    <input type="hidden" asp-for="Id" />
    <p class="alert alert-warning mb-3">Delete <strong>@Model.Name</strong>?</p>
    <div class="d-flex gap-2">
        <button class="btn btn-danger" type="submit">Delete</button>
        <a asp-area="Admin" asp-controller="AdminContent" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
