@model IReadOnlyList<ApexZenith.Models.News>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "News content";
}
<partial name="_ContentNavigation" model="@("News")" />
<partial name="_ContentTableStyles" />

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <p class="text-secondary mb-0">Manage published news and announcements.</p>
    <a asp-action="CreateNews" asp-route-returnTo="News" class="btn btn-primary btn-sm">Add News</a>
</div>

<div class="card admin-table-card">
    <div class="card-body table-responsive p-0">
        <table class="table table-striped table-hover content-table mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Headline</th>
                    <th>Author</th>
                    <th>Category</th>
                    <th>Published</th>
                    <th>Views</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-secondary">No news entries found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var modalId = $"delete-news-{item.Id}";
                        <tr>
                            <td>@item.Id</td>
                            <td class="truncate">@item.Headline</td>
                            <td>@item.Author</td>
                            <td><span class="badge text-bg-light border">@(string.IsNullOrWhiteSpace(item.PostedBy) ? "Uncategorized" : item.PostedBy)</span></td>
                            <td>@item.Date.ToString("dd MMM yyyy HH:mm")</td>
                            <td>@item.NumberOfViews</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="EditNews" asp-route-id="@item.Id" asp-route-returnTo="News" class="btn btn-outline-primary">Edit</a>
                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#@modalId">Delete</button>
                                </div>
                            </td>
                        </tr>

                        <div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Delete news entry</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        Delete news post <strong>@item.Headline</strong>?
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <form asp-action="DeleteNews" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="returnTo" value="News" />
                                            <button type="submit" class="btn btn-danger">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
