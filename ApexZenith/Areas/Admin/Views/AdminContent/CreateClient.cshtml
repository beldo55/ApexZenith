@model ApexZenith.Models.Client
@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Add Client"; }
<form asp-action="CreateClient" method="post" class="container">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3"><label class="form-label">Name</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
    <div class="mb-3"><label class="form-label">Logo</label><input asp-for="Logo" class="form-control" /><span asp-validation-for="Logo" class="text-danger small"></span></div>
    <div class="mb-3"><label class="form-label">Website</label><input asp-for="Website" class="form-control" /><span asp-validation-for="Website" class="text-danger small"></span></div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">Save</button>
        <a asp-area="Admin" asp-controller="AdminContent" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
