@model ApexZenith.Models.Services
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Service";
}
<form asp-action="EditService" method="post" class="container">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />
    <div class="mb-3"><label class="form-label">Name</label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Contents</label><textarea asp-for="Contents" class="form-control" rows="5"></textarea></div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">Update</button>
        <a asp-area="Admin" asp-controller="AdminContent" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
