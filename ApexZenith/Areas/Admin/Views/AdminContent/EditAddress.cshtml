@model ApexZenith.Models.Address
@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Edit Address"; }
<form asp-action="EditAddress" method="post" class="container">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />
    <div class="mb-3"><label class="form-label">Head Office</label><input asp-for="IsHeadOffice" class="form-control" /><span asp-validation-for="IsHeadOffice" class="text-danger small"></span></div>
    <div class="mb-3"><label class="form-label">Location</label><input asp-for="Location" class="form-control" /><span asp-validation-for="Location" class="text-danger small"></span></div>
    <div class="mb-3"><label class="form-label">Email</label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
    <div class="mb-3"><label class="form-label">Phone</label><input asp-for="Phone" class="form-control" /><span asp-validation-for="Phone" class="text-danger small"></span></div>
    <div class="mb-3"><label class="form-label">Map Url</label><input asp-for="GoogleMapUrl" class="form-control" /><span asp-validation-for="GoogleMapUrl" class="text-danger small"></span></div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">Update</button>
        <a asp-area="Admin" asp-controller="AdminContent" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
