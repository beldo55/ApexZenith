@model ApexZenith.Models.Team
@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Add Team Member"; }
<form asp-action="CreateTeam" method="post" class="container">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3"><label class="form-label">Name</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
    <div class="mb-3"><label class="form-label">Position</label><input asp-for="Position" class="form-control" /><span asp-validation-for="Position" class="text-danger small"></span></div>
    <div class="mb-3"><label class="form-label">Photo Url</label><input asp-for="PhotoUrl" class="form-control" /><span asp-validation-for="PhotoUrl" class="text-danger small"></span></div>
    <div class="mb-3"><label class="form-label">Facebook Url</label><input asp-for="FacebookUrl" class="form-control" /><span asp-validation-for="FacebookUrl" class="text-danger small"></span></div>
    <div class="mb-3"><label class="form-label">Instagram Url</label><input asp-for="InstergramUrl" class="form-control" /><span asp-validation-for="InstergramUrl" class="text-danger small"></span></div>
    <div class="mb-3"><label class="form-label">LinkedIn Url</label><input asp-for="LinkedInUrl" class="form-control" /><span asp-validation-for="LinkedInUrl" class="text-danger small"></span></div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">Save</button>
        <a asp-area="Admin" asp-controller="AdminContent" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
