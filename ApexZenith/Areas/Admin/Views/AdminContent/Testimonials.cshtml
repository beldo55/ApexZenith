@model IReadOnlyList<ApexZenith.Models.Testimonial>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Testimonial content";
}
<partial name="_ContentNavigation" model="@("Testimonials")" />
<partial name="_ContentTableStyles" />

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <p class="text-secondary mb-0">Manage testimonials shown throughout the site.</p>
    <a asp-action="CreateTestimonial" asp-route-returnTo="Testimonials" class="btn btn-primary btn-sm">Add Testimonial</a>
</div>

<div class="card admin-table-card">
    <div class="card-body table-responsive p-0">
        <table class="table table-striped table-hover content-table mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Position</th>
                    <th>Content</th>
                    <th>Photo</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-secondary">No testimonial entries found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var modalId = $"delete-testimonial-{item.Id}";
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Name</td>
                            <td>@item.Position</td>
                            <td class="truncate">@(string.IsNullOrWhiteSpace(item.Content) ? "—" : item.Content)</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.PhotoUrl))
                                {
                                    <img src="@item.PhotoUrl" alt="@item.Name" class="table-img-preview" />
                                }
                                else
                                {
                                    <span class="text-secondary small">No photo</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="EditTestimonial" asp-route-id="@item.Id" asp-route-returnTo="Testimonials" class="btn btn-outline-primary">Edit</a>
                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#@modalId">Delete</button>
                                </div>
                            </td>
                        </tr>

                        <div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Delete testimonial</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        Delete testimonial by <strong>@item.Name</strong>?
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <form asp-action="DeleteTestimonial" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="returnTo" value="Testimonials" />
                                            <button type="submit" class="btn btn-danger">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
