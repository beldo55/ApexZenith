@model IReadOnlyList<ApexZenith.Models.Client>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Client content";
}
<partial name="_ContentNavigation" model="@("Clients")" />
<partial name="_ContentTableStyles" />

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <p class="text-secondary mb-0">Manage client logos and links.</p>
    <a asp-action="CreateClient" asp-route-returnTo="Clients" class="btn btn-primary btn-sm">Add Client</a>
</div>

<div class="card admin-table-card">
    <div class="card-body table-responsive p-0">
        <table class="table table-striped table-hover content-table mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Logo</th>
                    <th>Website</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-secondary">No client entries found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var modalId = $"delete-client-{item.Id}";
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Name</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Logo))
                                {
                                    <img src="@item.Logo" alt="@item.Name" class="table-img-preview" />
                                }
                                else
                                {
                                    <span class="text-secondary small">No logo</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Website))
                                {
                                    <a href="@item.Website" target="_blank" rel="noopener noreferrer">@item.Website</a>
                                }
                                else
                                {
                                    <span class="text-secondary small">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="EditClient" asp-route-id="@item.Id" asp-route-returnTo="Clients" class="btn btn-outline-primary">Edit</a>
                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#@modalId">Delete</button>
                                </div>
                            </td>
                        </tr>

                        <div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Delete client</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        Delete client <strong>@item.Name</strong>?
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <form asp-action="DeleteClient" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="returnTo" value="Clients" />
                                            <button type="submit" class="btn btn-danger">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
