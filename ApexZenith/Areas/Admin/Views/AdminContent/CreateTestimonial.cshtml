@model ApexZenith.Models.Testimonial
@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Add Testimonial"; }
<form asp-action="CreateTestimonial" method="post" class="container">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3"><label class="form-label">Name</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
    <div class="mb-3"><label class="form-label">Position</label><input asp-for="Position" class="form-control" /><span asp-validation-for="Position" class="text-danger small"></span></div>
    <div class="mb-3"><label class="form-label">Content</label><textarea asp-for="Content" class="form-control" rows="5"></textarea><span asp-validation-for="Content" class="text-danger small"></span></div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">Save</button>
        <a asp-area="Admin" asp-controller="AdminContent" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
